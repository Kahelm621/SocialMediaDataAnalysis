# Copy this file to .env for local runs. Never commit .env.
# Leave a line blank if you do not have that key yet.
# The dashboard still builds from labeled demo data when keys are missing.
# Existing environment variables win over this file.

# Public YouTube channel stats, video stats, and keyword search.
YOUTUBE_API_KEY=

# Public metrics for @AyngelBytes and recent hashtag counts.
X_BEARER_TOKEN=

# Optional. TikTok Login Kit token for the account that approved your app.
# Official Display API only. This cannot read a random public handle.
TIKTOK_ACCESS_TOKEN=

# Optional. TikTok Research API token (app approval required) for hashtag queries.
TIKTOK_RESEARCH_TOKEN=

# Optional YouTube Analytics API (private CTR and average view percentage).
# Needs the Data API key as well, so the channel id can be resolved.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_ANALYTICS_REFRESH_TOKEN=
